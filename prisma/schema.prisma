generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  sku                String?  @unique
  salePrice          Decimal  @db.Decimal(14, 2)
  tecidoCost         Decimal  @default(0) @db.Decimal(14, 2)
  costuraCost        Decimal  @default(0) @db.Decimal(14, 2)
  aviamentosCost     Decimal  @default(0) @db.Decimal(14, 2)
  marketplaceFee     Decimal  @default(0) @db.Decimal(14, 2)
  shippingCost       Decimal  @default(0) @db.Decimal(14, 2)
  packagingCost      Decimal  @default(0) @db.Decimal(14, 2)
  avgMonthlyQuantity Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("products")
}

model BreakEvenSettings {
  id                   String   @id @default(cuid())
  marginAlertThreshold Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt            DateTime @updatedAt

  @@map("break_even_settings")
}

model MercadoLivreReceivable {
  id         String   @id @default(cuid())
  today      Decimal  @default(0) @db.Decimal(14, 2)
  tomorrow   Decimal  @default(0) @db.Decimal(14, 2)
  within7d   Decimal  @default(0) @db.Decimal(14, 2)
  after7d    Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt  DateTime @updatedAt

  @@map("mercado_livre_receivables")
}

enum AccountType {
  BANK
  CASH
}

enum EntryType {
  PAYABLE
  RECEIVABLE
}

enum ReserveCategory {
  THIRTEENTH
  VACATION
  CONTINGENCY
  TAX
}

enum EntryStatus {
  PENDING
  PAID
  CANCELED
}

enum CounterpartyType {
  PESSOA_FISICA
  PESSOA_JURIDICA
  OUTRO
}

enum OfxTrnType {
  DEBIT
  CREDIT
}

enum ImportSource {
  OFX
  XLSX
}

enum ParsedMemoKind {
  PIX_DEBIT
  PIX_CREDIT
  CARD_PURCHASE
  OTHER
}

enum MatchStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

enum DreGroup {
  RECEITA_BRUTA
  DEDUCOES_RECEITA
  CUSTO_MERCADORIA_VENDIDA
  CUSTO_VARIAVEL
  DESPESA_PESSOAL
  DESPESA_ADMINISTRATIVA
  DESPESA_COMERCIAL
  DESPESA_PRODUTIVA
  RESULTADO_FINANCEIRO_RECEITA
  RESULTADO_FINANCEIRO_DESPESA
  NAO_OPERACIONAL_RECEITA
  NAO_OPERACIONAL_DESPESA
}

model FinancialAccount {
  id                 String      @id @default(cuid())
  name               String
  type               AccountType
  bankId             String?
  acctId             String?
  acctType           String?
  currency           String      @default("BRL")
  openingBalance     Decimal     @default(0) @db.Decimal(14, 2)
  openingBalanceDate DateTime    @default(now())
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  entries              Entry[]
  importBatches        ImportBatch[]
  importedTransactions ImportedTransaction[]

  @@map("financial_accounts")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  type     EntryType?
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  isActive      Boolean    @default(true)
  dreGroup      DreGroup?
  // Marca a categoria como gasto com anúncio/publicidade, pra somar no CAC do Dashboard Executivo.
  isAdvertising Boolean    @default(false)

  entries        Entry[]
  counterparties Counterparty[]
  fixedCosts     FixedCost[]
  categoryRules  CategoryRule[]
  loans          Loan[]
  creditCardPurchases CreditCardPurchase[]

  @@map("categories")
}

model Loan {
  id                 String   @id @default(cuid())
  description        String
  principal          Decimal  @db.Decimal(14, 2)
  monthlyRatePercent Decimal  @db.Decimal(6, 4)
  installments       Int
  matchText          String
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id])
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("loans")
}

model CategoryRule {
  id         String   @id @default(cuid())
  keyword    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())

  @@map("category_rules")
}

model Counterparty {
  id                String           @id @default(cuid())
  name              String
  document          String?          @unique
  type              CounterpartyType @default(OUTRO)
  aliases           String[]         @default([])
  defaultCategoryId String?
  defaultCategory   Category?        @relation(fields: [defaultCategoryId], references: [id])
  isOwnEntity       Boolean          @default(false)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  entries    Entry[]
  fixedCosts FixedCost[]
  creditCardPurchases CreditCardPurchase[]

  @@map("counterparties")
}

model Entry {
  id                 String            @id @default(cuid())
  type               EntryType
  description        String
  amount             Decimal           @db.Decimal(14, 2)
  dueDate            DateTime
  plannedPaymentDate DateTime?
  competenceDate     DateTime?
  status             EntryStatus       @default(PENDING)
  paidAt             DateTime?
  paidAmount         Decimal?          @db.Decimal(14, 2)
  bankAccountId      String?
  bankAccount        FinancialAccount? @relation(fields: [bankAccountId], references: [id])
  categoryId         String?
  category           Category?         @relation(fields: [categoryId], references: [id])
  counterpartyId     String?
  counterparty       Counterparty?     @relation(fields: [counterpartyId], references: [id])
  fixedCostId        String?
  fixedCost          FixedCost?        @relation(fields: [fixedCostId], references: [id])
  creditCardPurchaseId String?
  creditCardPurchase   CreditCardPurchase? @relation(fields: [creditCardPurchaseId], references: [id])
  installmentNumber    Int?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  reconciliationMatch ReconciliationMatch?
  rejectedMatchPairs  RejectedMatchPair[]

  @@index([status, dueDate])
  @@map("entries")
}

model CreditCard {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases  CreditCardPurchase[]
  fixedCosts FixedCost[]

  @@map("credit_cards")
}

model CreditCardPurchase {
  id             String        @id @default(cuid())
  creditCardId   String
  creditCard     CreditCard    @relation(fields: [creditCardId], references: [id])
  description    String
  totalAmount    Decimal       @db.Decimal(14, 2)
  installments   Int
  purchaseDate   DateTime
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])
  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id])
  createdAt      DateTime      @default(now())

  generatedEntries Entry[]

  @@map("credit_card_purchases")
}

enum FiscalNoteDirection {
  SAIDA
  ENTRADA_PROPRIA
  ENTRADA_TERCEIRO
}

/**
 * NF-e (modelo 55) lida do XML — as de venda que a Holm emite (Tiny, devoluções
 * do Mercado Livre) e as de compra que os fornecedores mandam. Uma linha por
 * chave de acesso: importar o mesmo XML de novo regrava em vez de duplicar.
 * `direction` diz de que lado a Holm está (ver `classifyDirection`).
 */
model FiscalNote {
  id                   String              @id @default(cuid())
  accessKey            String              @unique
  direction            FiscalNoteDirection
  /** finNFe: 1 normal, 2 complementar, 3 ajuste, 4 devolução. */
  purpose              Int
  /** tpNF do ponto de vista de quem emitiu: 0 entrada, 1 saída. */
  operationType        Int
  natureOfOperation    String
  number               Int
  series               Int
  issuedAt             DateTime
  /** "YYYY-MM" tirado do texto de dhEmi — agrupar por issuedAt em UTC jogaria
   * notas da noite do último dia no mês seguinte. */
  issueMonth           String
  issuerDocument       String
  issuerName           String
  issuerUf             String
  issuerCrt            Int?
  recipientDocument    String?
  recipientName        String?
  recipientUf          String?
  finalConsumer        Boolean
  intermediaryDocument String?
  productsTotal        Decimal             @db.Decimal(14, 2)
  discountTotal        Decimal             @db.Decimal(14, 2)
  freightTotal         Decimal             @db.Decimal(14, 2)
  otherTotal           Decimal             @db.Decimal(14, 2)
  total                Decimal             @db.Decimal(14, 2)
  icmsTotal            Decimal             @db.Decimal(14, 2)
  icmsStTotal          Decimal             @db.Decimal(14, 2)
  ipiTotal             Decimal             @db.Decimal(14, 2)
  pisTotal             Decimal             @db.Decimal(14, 2)
  cofinsTotal          Decimal             @db.Decimal(14, 2)
  difalTotal           Decimal             @db.Decimal(14, 2)
  simplesCreditTotal   Decimal             @db.Decimal(14, 2)
  referencedKeys       String[]
  cancelledAt          DateTime?
  importedAt           DateTime            @default(now())

  items FiscalNoteItem[]

  @@index([issueMonth])
  @@index([issuerDocument])
  @@map("fiscal_notes")
}

model FiscalNoteItem {
  id                 String     @id @default(cuid())
  noteId             String
  note               FiscalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  itemNumber         Int
  productCode        String
  description        String
  ncm                String
  cfop               String
  quantity           Decimal    @db.Decimal(15, 4)
  grossValue         Decimal    @db.Decimal(14, 2)
  discount           Decimal    @db.Decimal(14, 2)
  netValue           Decimal    @db.Decimal(14, 2)
  icmsCode           String?
  icmsBase           Decimal    @db.Decimal(14, 2)
  icmsRate           Decimal    @db.Decimal(7, 4)
  icmsValue          Decimal    @db.Decimal(14, 2)
  simplesCreditValue Decimal    @db.Decimal(14, 2)

  @@index([noteId])
  @@map("fiscal_note_items")
}

/**
 * Cancelamentos lidos dos XMLs de evento, guardados à parte: o evento pode
 * chegar num .zip antes (ou sem) a própria nota, e precisa valer quando ela
 * for importada depois.
 */
model FiscalNoteCancellation {
  accessKey   String   @id
  cancelledAt DateTime
  importedAt  DateTime @default(now())

  @@map("fiscal_note_cancellations")
}

/**
 * NFS-e que empresas do grupo Mercado Livre emitem contra a Holm (Ebazar e
 * filiais de envio, Mercado Pago), lidas do PDF "Demonstrativo de Nota
 * Fiscal". Quase tudo já saiu descontado dos repasses: é custo do mês,
 * nunca conta a pagar — lançar como conta contaria o custo duas vezes.
 */
model MlServiceInvoice {
  id               String   @id @default(cuid())
  /** Link da nota na prefeitura, ou prestador+data+valor+arquivo quando o
   * link é genérico (ver `mlServiceDedupeKey`). Reimportar não duplica. */
  dedupeKey        String   @unique
  providerName     String
  providerDocument String
  providerCity     String
  amount           Decimal  @db.Decimal(14, 2)
  /** "YYYY-MM" do campo MÊS REF. */
  referenceMonth   String
  issuedOn         DateTime @db.Date
  link             String?
  sourceFileName   String
  importedAt       DateTime @default(now())

  @@index([referenceMonth])
  @@map("ml_service_invoices")
}

model SalesImportBatch {
  id             String   @id @default(cuid())
  fileName       String
  fileHash       String   @unique
  rowCount       Int
  importedCount  Int
  duplicateCount Int
  importedAt     DateTime @default(now())

  sales MarketplaceSale[]

  @@map("sales_import_batches")
}

model MarketplaceSale {
  id               String            @id @default(cuid())
  orderId          String            @unique
  saleDate         DateTime
  sku              String
  productName      String
  channel          String            @default("Mercado Livre")
  shippingModality String?
  quantity         Int
  grossRevenue     Decimal           @db.Decimal(14, 2)
  netRevenue       Decimal           @db.Decimal(14, 2)
  /** "Custo (-)" do Mercado Turbo — custo de produto já descontado por ELE
   * dentro do netRevenue. Guardado à parte pra somar de volta antes de
   * descontar o custo de produção cadastrado no Holm Finance, evitando
   * descontar o mesmo custo duas vezes. Sempre 0 pra vendas da Shopee. */
  marketplaceCost  Decimal           @default(0) @db.Decimal(14, 2)
  customerName     String?
  status           String
  importBatchId    String?
  importBatch      SalesImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt        DateTime          @default(now())

  @@index([saleDate])
  @@map("marketplace_sales")
}

/**
 * Vendas lidas do relatório que o Mercado Livre exporta direto ("Vendas BR"),
 * numa tabela própria em vez de dentro de MarketplaceSale.
 *
 * Os dois relatórios descrevem os MESMOS pedidos com contas incompatíveis: o
 * Mercado Turbo entrega margem de contribuição (custo do produto já
 * descontado), o export nativo entrega o líquido do marketplace (antes do
 * custo do produto) — no mesmo pedido isso dá quase o triplo. Gravar os dois
 * na mesma linha faria a DRE, a margem por produto e o ponto de equilíbrio
 * lerem uma coisa pela outra, dependendo de qual planilha foi importada por
 * último. Aqui o export nativo serve ao que só ele sabe responder: quando o
 * dinheiro é liberado.
 */
model MercadoLivreSale {
  id               String    @id @default(cuid())
  orderId          String    @unique
  saleDate         DateTime
  sku              String
  productName      String
  status           String
  shippingModality String?
  customerName     String?
  quantity         Int
  /** O que o comprador pagou: produto + acréscimo de parcelamento + envio. */
  grossRevenue     Decimal   @db.Decimal(14, 2)
  /** Coluna "Total (BRL)" — o líquido que o Mercado Livre repassa, já sem as
   * tarifas de venda e de envio. É este valor que entra no caixa. */
  netTotal         Decimal   @db.Decimal(14, 2)
  /** Data em que o comprador recebeu o pacote; nula enquanto não entregue. */
  deliveredAt      DateTime?
  /** Data estimada do repasse (entrega + prazo de liberação). */
  releaseDate      DateTime?
  /** "agosto 2026" — em qual fatura mensal as tarifas dessa venda caem. */
  billingMonth     String?
  importedAt       DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([releaseDate])
  @@index([saleDate])
  @@map("mercado_livre_sales")
}

enum FixedCostFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
  BIWEEKLY_ROLLING
}

model FixedCost {
  id             String             @id @default(cuid())
  type           EntryType          @default(PAYABLE)
  description    String
  amount         Decimal            @db.Decimal(14, 2)
  frequency      FixedCostFrequency @default(MONTHLY)
  // MONTHLY: dia do mês. BIWEEKLY: dueDay = 1º dia, secondDueDay = 2º dia (dois dias fixos por mês).
  // WEEKLY: weekday (0=domingo..6=sábado), dueDay/secondDueDay não usados.
  // BIWEEKLY_ROLLING: anchorDate = data-base; ocorrências caem a cada 14 dias corridos a partir
  // dela, sem resetar no início do mês (as datas vão mudando mês a mês, diferente de BIWEEKLY).
  dueDay         Int?
  secondDueDay   Int?
  weekday        Int?
  anchorDate     DateTime?
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])
  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id])
  creditCardId   String?
  creditCard     CreditCard?   @relation(fields: [creditCardId], references: [id])
  // Marca custos fixos que representam salário (empregado CLT ou pró-labore),
  // usados como base pro cálculo de provisão de 13º e férias.
  laborProvisionEligible Boolean @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  generatedEntries Entry[]

  @@map("fixed_costs")
}

model ImportBatch {
  id                String           @id @default(cuid())
  bankAccountId     String
  bankAccount       FinancialAccount @relation(fields: [bankAccountId], references: [id])
  source            ImportSource     @default(OFX)
  fileName          String
  fileHash          String
  startDate         DateTime
  endDate           DateTime
  ledgerBalance     Decimal?         @db.Decimal(14, 2)
  ledgerBalanceDate DateTime?
  transactionCount  Int
  importedAt        DateTime         @default(now())

  transactions ImportedTransaction[]

  @@unique([bankAccountId, fileHash])
  @@map("import_batches")
}

model ImportedTransaction {
  id                     String           @id @default(cuid())
  bankAccountId          String
  bankAccount            FinancialAccount @relation(fields: [bankAccountId], references: [id])
  importBatchId          String
  importBatch            ImportBatch      @relation(fields: [importBatchId], references: [id])
  fitId                  String
  trnType                OfxTrnType
  postedAt               DateTime
  amount                 Decimal          @db.Decimal(14, 2)
  memo                   String
  parsedKind             ParsedMemoKind   @default(OTHER)
  parsedDocument         String?
  parsedCounterpartyName String?
  parsedCity             String?
  isSelfTransfer         Boolean          @default(false)
  createdAt              DateTime         @default(now())

  reconciliationMatch ReconciliationMatch?
  rejectedMatchPairs  RejectedMatchPair[]

  @@unique([bankAccountId, fitId])
  @@map("imported_transactions")
}

model ReconciliationMatch {
  id                    String               @id @default(cuid())
  importedTransactionId String               @unique
  importedTransaction   ImportedTransaction  @relation(fields: [importedTransactionId], references: [id])
  entryId               String?              @unique
  entry                 Entry?               @relation(fields: [entryId], references: [id])
  status                MatchStatus          @default(SUGGESTED)
  matchScore            Float
  matchReasons          String[]             @default([])
  confirmedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@map("reconciliation_matches")
}

/**
 * Histórico permanente de pares (lançamento, transação) que a analista já
 * rejeitou explicitamente — separado do ReconciliationMatch (que só guarda
 * o estado ATUAL de cada transação/lançamento, um registro por um) porque
 * rejeitar precisa liberar os dois lados pra casar com outra coisa, mas sem
 * deixar o algoritmo sugerir esse MESMO par de novo, indefinidamente.
 */
model RejectedMatchPair {
  id                    String              @id @default(cuid())
  importedTransactionId String
  importedTransaction   ImportedTransaction @relation(fields: [importedTransactionId], references: [id], onDelete: Cascade)
  entryId               String
  entry                 Entry               @relation(fields: [entryId], references: [id], onDelete: Cascade)
  rejectedAt            DateTime            @default(now())

  @@unique([importedTransactionId, entryId])
  @@map("rejected_match_pairs")
}

model ReserveDeposit {
  id        String          @id @default(cuid())
  category  ReserveCategory
  amount    Decimal         @db.Decimal(14, 2)
  date      DateTime
  notes     String?
  createdAt DateTime        @default(now())

  @@map("reserve_deposits")
}

enum BalanceSheetSection {
  ATIVO_CIRCULANTE
  ATIVO_NAO_CIRCULANTE
  PASSIVO_CIRCULANTE
  PASSIVO_NAO_CIRCULANTE
  PATRIMONIO_LIQUIDO
}

model BalanceSheetItem {
  id          String              @id @default(cuid())
  section     BalanceSheetSection
  description String
  amount      Decimal             @db.Decimal(14, 2)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("balance_sheet_items")
}

/**
 * Chave de acesso bipada de uma nota impressa (o código de barras do DANFE).
 * Serve para reconhecer a nota antes do XML: enquanto ele não é importado, a
 * chave aparece como pendente na tela de Notas Fiscais. A lista de pendentes é
 * um LEFT JOIN com fiscal_notes, então a chave some sozinha quando o XML entra.
 */
model ScannedNoteKey {
  accessKey String   @id
  scannedAt DateTime @default(now())

  @@map("scanned_note_keys")
}
